# --- OpenAI (required for chat / voice) ---
OPENAI_API_KEY="sk-..."

# --- Database (SQLite via libSQL) ---
# Turso (cloud): from `turso db show <name> --url` and `turso db tokens create <name>`
DATABASE_URL="libsql://your-db-yourorg.turso.io"
TURSO_AUTH_TOKEN="your-turso-token"

# Local file SQLite (optional dev / schema tooling). Path is relative to prisma/schema.prisma → prisma/dev.db
# DATABASE_URL="file:./dev.db"
# (omit TURSO_AUTH_TOKEN for file: URLs)

# --- Owner dashboard ---
# Long random secret (32+ characters). Required in production.
DASHBOARD_GATEWAY_TOKEN="change-me-to-a-long-random-secret-at-least-32-chars"

# --- Optional: chat model override ---
# OPENAI_MODEL="gpt-4o-mini"

# --- Optional: OpenAI Realtime (voice) ---
# OPENAI_REALTIME_MODEL="gpt-realtime"
# OPENAI_REALTIME_TRANSCRIBE_MODEL="gpt-4o-mini-transcribe"
# OPENAI_REALTIME_VOICE="marin"
# OPENAI_REALTIME_INPUT_TRANSCRIPTION="1"

# --- Optional: Supabase Storage (PDF originals in bucket `knowledge-pdfs`) ---
# NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="..."

# --- Optional: admin / booking UX ---
# NEXT_PUBLIC_DASHBOARD_TIMEZONE="Europe/London"
# BOOKING_INPUT_TIMEZONE="Europe/London"
# KNOWLEDGE_IMAGE_ALLOWED_HOSTS="picsum.photos,images.unsplash.com"
