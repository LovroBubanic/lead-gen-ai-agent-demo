generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lead {
  id        String   @id @default(cuid())
  name      String?
  email     String?
  intent    String?
  summary   String?
  createdAt DateTime @default(now())
}

model KnowledgeDocument {
  id         String   @id @default(cuid())
  title      String
  content    String
  sourceType String   @default("text") // text | pdf
  filePath   String? // Supabase Storage path in bucket `knowledge-pdfs`, if uploaded
  /// JSON array of strings: Supabase object paths and/or https URLs for listing photos (chat tool `showListingImage`).
  imagePaths String?
  createdAt  DateTime @default(now())
}

/// Singleton row (`id = "global"`): how the owner wants the agent to talk to visitors.
model AgentSettings {
  id                   String   @id @default("global")
  customerInstructions String   @default("")
  /// ISO 639-1 language code for visitor UI, chat, and voice (e.g. en, es, de).
  customerLocale       String   @default("en")
  /// OpenAI Realtime voice id used for customer voice calls.
  realtimeVoice        String   @default("marin")
  /// light | dark — persisted owner dashboard appearance (also synced to localStorage on admin).
  dashboardTheme       String   @default("light")
  /// Color palette id for public /chat and /call (see lib/visitor-ui-palettes.ts).
  visitorUiPalette     String   @default("default")
  updatedAt            DateTime @updatedAt
}

model Meeting {
  id              String   @id @default(cuid())
  title           String
  startAt         DateTime
  endAt           DateTime
  attendeeName    String?
  attendeeEmail   String?
  notes           String?
  /// google_meet | zoom | phone | other — how the owner should join
  meetingType     String?
  /// Link (Meet/Zoom) or phone number the visitor agreed to
  locationDetail  String?
  bookedByAgent   Boolean  @default(true)
  createdAt       DateTime @default(now())
}
