{
  "name": "ai-customer-support-lead-gen-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev --turbopack",
    "dev:webpack": "node ./node_modules/next/dist/bin/next dev",
    "build": "node node_modules/prisma/build/index.js generate && node ./node_modules/next/dist/bin/next build --turbopack",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "db:push": "node node_modules/prisma/build/index.js generate && node node_modules/prisma/build/index.js db push",
    "db:seed": "node node_modules/prisma/build/index.js db seed",
    "check:db-env": "node scripts/check-supabase-env.cjs"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.52",
    "@ai-sdk/react": "^3.0.160",
    "@langchain/core": "^1.1.40",
    "@langchain/langgraph": "^1.2.9",
    "@langchain/openai": "^1.4.4",
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.103.0",
    "ai": "^6.0.158",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "jose": "^6.2.2",
    "lucide-react": "^1.8.0",
    "next": "15.5.15",
    "pdf-parse": "^2.4.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.15",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
